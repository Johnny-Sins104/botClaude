BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here

# ─── Modalità ──────────────────────────────────────────────────────────────────
# true  = paper trading (nessun ordine reale, solo simulazione)
# false = live trading (ATTENZIONE: ordini reali su Binance)
PAPER_MODE=true

# ─── Asset e capitale ──────────────────────────────────────────────────────────
SYMBOL=BTCUSDT          # coppia da tradare (es. ETHUSDT, SOLUSDT, BNBUSDT)
CAPITAL=1000.0          # USDT allocati al bot

# ─── Strategia ─────────────────────────────────────────────────────────────────
# ema  = EMA crossover + RSI + VWAP
# bb   = Bollinger Bands mean reversion
# macd = MACD crossover
# ichi = Ichimoku Cloud
STRATEGY=ema

# ─── Gestione rischio ──────────────────────────────────────────────────────────
RISK_PCT=1.0            # % del capitale rischiata per trade (1 = 1%)
TP_RATIO=2.0            # Take Profit = SL × TP_RATIO  (risk/reward)

# ─── Parametri EMA ─────────────────────────────────────────────────────────────
EMA_FAST=9
EMA_SLOW=21

# ─── Parametri Bollinger Bands ──────────────────────────────────────────────────
BB_PERIOD=20
BB_DEV=2.0

# ─── Parametri MACD ────────────────────────────────────────────────────────────
MACD_FAST=12
MACD_SLOW=26
MACD_SIG=9

# ─── Parametri Ichimoku ────────────────────────────────────────────────────────
ICHI_T=9
ICHI_K=26
ICHI_S=52

# ─── Miglioramenti strategia ───────────────────────────────────────────────────
# Trailing stop: lo stop segue il prezzo a favore (true = attivo)
TRAILING_STOP=true

# Filtro anti-whipsaw: blocca entry se EMA troppo vicine (mercato laterale)
WHIPSAW_FILTER=true

# Filtro multi-timeframe: entra solo se il trend su 5m è allineato con 1m
MTF_FILTER=true
