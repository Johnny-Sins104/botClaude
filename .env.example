BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here

# ─── Modalità ──────────────────────────────────────────────────────────────────
# true  = paper trading, nessun ordine reale
# false = BLOCCATO: questa build è paper-only
PAPER_MODE=true
HOST=127.0.0.1
PORT=8000

# ─── Asset e capitale ──────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
CAPITAL=1000.0

# ─── Strategia manuale / fallback ──────────────────────────────────────────────
# strategie consentite: ema, bb, macd, ichi
STRATEGY=ema

# Se true, il bot sceglie automaticamente tra ema/bb/macd/ichi in base al regime.
# Non è una quinta strategia: è solo un selettore tra le 4 esistenti.
AUTO_STRATEGY_SELECTOR=true
AUTO_STRATEGY_MIN_SCORE=70
AUTO_STRATEGY_COOLDOWN_CANDLES=3
AUTO_STRATEGY_FALLBACK=ema

# ─── Gestione rischio ──────────────────────────────────────────────────────────
# Nessun parametro è stato validato come profittevole su dati out-of-sample.
# Non modificare TP_RATIO/SL_ATR_MULT/MIN_ENTRY_SCORE senza backtest a 90 giorni.
RISK_PCT=0.3
TP_RATIO=2.0
SL_ATR_MULT=1.2
MAX_NOTIONAL_PCT=0.35
MIN_ENTRY_SCORE=75
ALLOW_SHORT=false
TRAILING_STOP=false
POST_SL_COOLDOWN_CANDLES=5
FEE_PCT=0.001
SLIPPAGE_PCT=0.0002
DAILY_LOSS_LIMIT_ENABLED=true
DAILY_LOSS_LIMIT_PCT=3.0

# ─── Parametri EMA ─────────────────────────────────────────────────────────────
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14

# ─── Parametri Bollinger Bands ──────────────────────────────────────────────────
BB_PERIOD=20
BB_DEV=2.0

# ─── Parametri MACD ────────────────────────────────────────────────────────────
MACD_FAST=12
MACD_SLOW=26
MACD_SIG=9

# ─── Parametri Ichimoku ────────────────────────────────────────────────────────
ICHI_T=9
ICHI_K=26
ICHI_S=52

# ─── Filtri ────────────────────────────────────────────────────────────────────
WHIPSAW_FILTER=true
MTF_FILTER=true

# ─── Filtro HTF Trend (5m EMA fast/slow) ────────────────────────────────────────
# Blocca BUY se il trend 5m non è bullish e SELL se non è bearish.
# Riduce gli ingressi controtrend (vedi backtest nel README).
HTF_TREND_FILTER=true
HTF_TREND_FAST=50
HTF_TREND_SLOW=100
HTF_TREND_MIN_GAP_PCT=0.02

# ─── Alert capitale / Telegram ──────────────────────────────────────────────────
# Alert quando il capitale scende sotto (init - MIN_CAPITAL_ALERT_PCT%).
MIN_CAPITAL_ALERT_PCT=10.0
# Lascia vuoti per disattivare le notifiche Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── WebSocket reconnect ───────────────────────────────────────────────────────
RECONNECT_INITIAL_DELAY_SEC=2
RECONNECT_MAX_DELAY_SEC=60
